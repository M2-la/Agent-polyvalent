# ============================================================
# AGENT IA POLYVALENT — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# ============================================================

# --- Anthropic / Claude ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Nom de l'utilisateur (signature emails) ---
USER_FIRSTNAME=Prénom

# --- Gmail OAuth2 (optionnel, sinon SMTP) ---
# Télécharger credentials.json depuis Google Cloud Console
# https://console.cloud.google.com/apis/credentials
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json

# --- SMTP (alternative à Gmail OAuth2) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre.email@gmail.com
SMTP_PASSWORD=votre_mot_de_passe_application
# Créer un mot de passe d'application : https://myaccount.google.com/apppasswords

# --- Base de données SQLite ---
DB_PATH=data/agent.db

# --- Dossier rapports ---
REPORTS_DIR=reports

# --- API externe pour BI (optionnel) ---
BI_API_URL=https://api.example.com
BI_API_KEY=votre_cle_api
BI_API_HEADERS={"Authorization": "Bearer votre_token"}

# --- Planification rapports automatiques ---
# Format cron : minute heure jour_mois mois jour_semaine
BI_REPORT_SCHEDULE=0 8 * * 1-5
